{
    "name": "@eliware/discord",
    "type": "module",
    "version": "1.1.3",
    "description": "A modular, extensible Discord app framework for Node.js with slash command, localization, and event-driven support.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent --runInBand",
        "lint": "npx oxlint .",
        "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/discord.git"
    },
    "keywords": [
        "discord",
        "discord-app",
        "discordjs",
        "discord-js",
        "discord-app-framework",
        "discord-app-template",
        "slash-commands",
        "localization",
        "i18n",
        "event-driven",
        "nodejs",
        "node",
        "framework",
        "typescript",
        "app",
        "modular",
        "extensible"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bugs": {
        "url": "https://github.com/eliware/discord/issues"
    },
    "homepage": "https://github.com/eliware/discord#readme",
    "devDependencies": {
        "jest": "^30.4.2",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^1.1.7",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2"
    }
}
