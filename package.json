{
    "name": "@eliware/discord",
    "type": "module",
    "version": "1.1.4",
    "description": "A modular, extensible Discord app framework for Node.js with slash command, localization, and event-driven support.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/discord.git"
    },
    "keywords": [
        "discord",
        "discord-app",
        "discordjs",
        "discord-js",
        "discord-app-framework",
        "discord-app-template",
        "slash-commands",
        "localization",
        "i18n",
        "event-driven",
        "nodejs",
        "node",
        "framework",
        "typescript",
        "app",
        "modular",
        "extensible"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "bugs": {
        "url": "https://github.com/eliware/discord/issues"
    },
    "homepage": "https://github.com/eliware/discord#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^2.0.0",
        "discord.js": "^14.27.0"
    }
}
